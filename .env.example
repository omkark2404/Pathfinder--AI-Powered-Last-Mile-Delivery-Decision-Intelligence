# ============================================================
# LastMile Delivery Intelligence — Environment Configuration
# ============================================================
# Copy this file to .env and fill in your values.
# The .env file is gitignored — NEVER commit it.
# ============================================================

# --- Database ---
# PostgreSQL (used by Docker Compose and production):
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=lastmile_db
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Full async DSN — overrides the individual POSTGRES_* variables above.
# For PostgreSQL: postgresql+asyncpg://user:pass@host:5432/dbname
# For local SQLite (development, no Docker): leave DATABASE_URL unset.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/lastmile_db

# --- Security ---
# REQUIRED in production: generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
# The default below is intentionally weak — it must be replaced before deployment.
SECRET_KEY=supersecretkey_change_in_production_32bytes!

# --- CORS ---
# Comma-separated list of allowed frontend origins.
# Use "*" only for local development.
# In production set to your actual domain(s): https://your-app.example.com
ALLOWED_ORIGINS=*

# --- Application ---
ENVIRONMENT=development
DATA_DIR=./data
